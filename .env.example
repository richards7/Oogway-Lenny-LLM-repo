# Database Settings
POSTGRES_DB=lenny_growth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth

# Active Model Provider: ollama | anthropic | openai | openrouter | gemini | auto
# For local demo: keep as "ollama" — no cloud keys required
LLM_PROVIDER=ollama

# Ollama Settings (REQUIRED for local/demo mode)
# Run: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FALLBACK_MODEL=llama3.2:1b

# Cloud Model Keys (Optional — leave blank to use local Ollama only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=6
RETRIEVAL_SIMILARITY_THRESHOLD=0.30

# API Settings
HOST=0.0.0.0
PORT=8000
