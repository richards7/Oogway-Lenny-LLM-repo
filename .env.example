# Database Settings
POSTGRES_DB=lenny_growth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth

# Active Model Provider: ollama | anthropic | openai | openrouter | gemini
# "ollama"     = fully local, no keys needed (demo default)
# "anthropic"  = smart: uses GEMINI_API_KEY if set, else ANTHROPIC_API_KEY
# "openai"     = smart: uses OPENROUTER_API_KEY if set, else OPENAI_API_KEY
LLM_PROVIDER=ollama

# --- Local LLM (Demo path — no cloud keys needed) ---
# Run first: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FALLBACK_MODEL=llama3.2:1b

# --- Cloud Keys (Scalable key strategy) ---
# "anthropic" provider: paste your GEMINI key here if you don't have Anthropic,
# OR paste a real ANTHROPIC key here and leave GEMINI_API_KEY blank.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# "openai" provider: paste your OPENROUTER key here if you don't have OpenAI,
# OR paste a real OPENAI key here and leave OPENROUTER_API_KEY blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Free-tier cloud alternatives (developer keys — team can leave these blank)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=6
RETRIEVAL_SIMILARITY_THRESHOLD=0.30

# API Settings
HOST=0.0.0.0
PORT=8000
